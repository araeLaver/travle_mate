{
  "expo": {
    "name": "두리메이트",
    "slug": "fryndo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "doorimate",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A3AFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doorimate.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:doorimate.com"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "두리메이트는 주변 NFT 수집 장소를 찾기 위해 위치 정보가 필요합니다.",
        "NSCameraUsageDescription": "두리메이트는 프로필 사진을 촬영하기 위해 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "두리메이트는 프로필 사진을 선택하기 위해 사진 라이브러리 접근이 필요합니다.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F4F1"
      },
      "package": "com.doorimate.app",
      "versionCode": 7,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.BILLING",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "doorimate.com",
              "pathPrefix": "/share"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4A3AFF",
          "sounds": [
            "./assets/sounds/chat.wav"
          ]
        }
      ],
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "두리메이트는 프로필 사진 촬영 및 장소 인증을 위해 카메라 접근이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "두리메이트는 프로필 사진을 갤러리에서 선택하기 위해 사진 접근이 필요합니다.",
          "cameraPermission": "두리메이트는 프로필 사진을 촬영하기 위해 카메라 접근이 필요합니다."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "두리메이트는 빠른 로그인을 위해 Face ID를 사용합니다."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "doorimate",
          "project": "doorimate-mobile"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "apiUrl": "https://fryndo-untab-f93a6aa7.koyeb.app",
      "webUrl": "https://fryndo-web.vercel.app",
      "googleIosClientId": "383693754351-0m0n2dhcqrurbkjm29u97hnte2si2nln.apps.googleusercontent.com",
      "googleAndroidClientId": "383693754351-pcpbb3uk259m6s6a84rua71cjnrrpguq.apps.googleusercontent.com",
      "googleWebClientId": "383693754351-fatu4q4r7p5stpqd237bngbjh3hinais.apps.googleusercontent.com",
      "googleExpoClientId": "383693754351-fatu4q4r7p5stpqd237bngbjh3hinais.apps.googleusercontent.com",
      "sentryDsn": "https://your-sentry-dsn@sentry.io/project-id",
      "eas": {
        "projectId": "f9508e1a-a6fc-4572-801b-a96b72d670ee"
      }
    },
    "owner": "downlab",
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/f9508e1a-a6fc-4572-801b-a96b72d670ee"
    }
  }
}
