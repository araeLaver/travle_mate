# ==========================================
# 1. Frontend Build Stage
# ==========================================
FROM node:20-alpine AS frontend-build
WORKDIR /app/frontend

COPY travelmate-web/package*.json ./
RUN npm ci --legacy-peer-deps

COPY travelmate-web/ ./
# 빌드 시 필요한 환경 변수
ENV REACT_APP_API_URL=/api
ENV REACT_APP_WS_URL=/ws

RUN npm run build

# ==========================================
# 2. Node.js Backend Build Stage
# ==========================================
FROM node:20-alpine AS backend-build
WORKDIR /app/backend

COPY travelmate-node-backend/package*.json ./
RUN npm ci

COPY travelmate-node-backend/ ./
RUN npm run build

# ==========================================
# 3. Final Runtime Stage
# ==========================================
FROM node:20-alpine
WORKDIR /app

# 보안을 위해 비루트 사용자 생성
RUN addgroup -S travelmate && adduser -S travelmate -G travelmate

# 백엔드 프로덕션 의존성만 설치
COPY travelmate-node-backend/package*.json ./
RUN npm ci --omit=dev

# 백엔드 컴파일된 코드 복사
COPY --from=backend-build /app/backend/dist ./dist

# 프론트엔드 정적 파일 복사
COPY --from=frontend-build /app/frontend/build ./public

RUN chown -R travelmate:travelmate /app
USER travelmate

EXPOSE 8080

CMD ["npm", "start"]
