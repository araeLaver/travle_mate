{
  "index_patterns": ["travelmate-logs-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "travelmate-logs-policy",
      "index.lifecycle.rollover_alias": "travelmate-logs"
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "timestamp": {
          "type": "date"
        },
        "processed_at": {
          "type": "date"
        },
        "level": {
          "type": "keyword"
        },
        "logger_name": {
          "type": "keyword"
        },
        "thread_name": {
          "type": "keyword"
        },
        "message": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "log_message": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "service": {
          "type": "keyword"
        },
        "environment": {
          "type": "keyword"
        },
        "http_method": {
          "type": "keyword"
        },
        "request_path": {
          "type": "keyword"
        },
        "query_string": {
          "type": "keyword"
        },
        "status_code": {
          "type": "integer"
        },
        "response_time_ms": {
          "type": "float"
        },
        "client_ip": {
          "type": "ip"
        },
        "user_id": {
          "type": "long"
        },
        "exception_class": {
          "type": "keyword"
        },
        "exception_message": {
          "type": "text"
        },
        "stack_trace": {
          "type": "text"
        },
        "error_type": {
          "type": "keyword"
        },
        "container": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "id": {
              "type": "keyword"
            },
            "image": {
              "properties": {
                "name": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "geoip": {
          "properties": {
            "continent_code": {
              "type": "keyword"
            },
            "country_code2": {
              "type": "keyword"
            },
            "country_code3": {
              "type": "keyword"
            },
            "country_name": {
              "type": "keyword"
            },
            "region_name": {
              "type": "keyword"
            },
            "city_name": {
              "type": "keyword"
            },
            "postal_code": {
              "type": "keyword"
            },
            "latitude": {
              "type": "float"
            },
            "longitude": {
              "type": "float"
            },
            "location": {
              "type": "geo_point"
            },
            "timezone": {
              "type": "keyword"
            }
          }
        },
        "ua": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "os": {
              "type": "keyword"
            },
            "os_name": {
              "type": "keyword"
            },
            "device": {
              "type": "keyword"
            }
          }
        },
        "tags": {
          "type": "keyword"
        },
        "mdc": {
          "type": "object",
          "dynamic": true
        }
      }
    }
  },
  "priority": 100,
  "version": 1
}
